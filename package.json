{
  "name": "meco-mission-control-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "sim:reset": "node scripts/reset-ios-sim.js",
    "preios": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} node scripts/reset-ios-sim.js",
    "verify": "npm run verify:core && npm run verify:bootstrap-contract",
    "verify:core": "npm run lint && npm run test && npm run test:role-permissions && npm run test:workflow-security && npm run typecheck",
    "dev": "node scripts/run-build-and-run.js --android",
    "start": "expo start",
    "android": "node scripts/run-build-and-run.js --android",
    "ios": "DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode-beta.app/Contents/Developer} expo start --localhost --port 8081",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:role-permissions": "node --test scripts/role-permissions.test.mjs",
    "test:workflow-security": "node --test scripts/workflow-security.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:bootstrap-contract": "node scripts/verify-bootstrap-contract.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.12",
    "expo-build-properties": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.10",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "postcss": "^8.5.15",
    "uuid": "^11.1.1"
  },
  "private": true
}
